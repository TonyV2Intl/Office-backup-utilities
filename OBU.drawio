        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    n_0([\&quot;程序启动\&quot;])\n    n_1(\&quot;读取配置文件\nOBU6.2.json\&quot;)\n    n_2(\&quot;初始化日志系统\nOBUlatest.log\&quot;)\n    n_3(\&quot;设置控制台窗口显示/隐藏\&quot;)\n    n_4(\&quot;初始化全局变量\n文件跳过计数 / SaveAs激活标记 / 会话出现标记\&quot;)\n    n_5{\&quot;OpenList上传是否启用?\&quot;}\n    n_6(\&quot;后台线程: OpenList初始化\n登录 + 拉取远端文件列表\&quot;)\n    n_7(\&quot;主循环\&quot;)\n    n_8(\&quot;等待配置的轮询间隔\&quot;)\n\n    n_0 --&gt; n_1\n    n_1 --&gt; n_2\n    n_2 --&gt; n_3\n    n_3 --&gt; n_4\n    n_4 --&gt; n_5\n    n_5 --&gt;|是| n_6\n    n_5 --&gt;|否| n_7\n    n_6 --&gt; n_7\n    n_7 --&gt; n_8\n    n_8 --&gt; n_7\n\n    subgraph n_9 [主循环 - 按配置间隔轮询]\n        direction LR\n        n_10(\&quot;PPT备份函数\&quot;)\n        n_11(\&quot;Word备份函数\&quot;)\n        n_12(\&quot;WPS备份函数\&quot;)\n        n_13(\&quot;精确备份函数\n子线程运行\&quot;)\n    end\n\n    subgraph n_14 [单个备份函数内部流程]\n        n_15(\&quot;检查/创建备份目录\&quot;)\n        n_16(\&quot;通过COM接口获取应用实例\nDispatch / GetObject\&quot;)\n        n_17(\&quot;遍历所有打开的文档\&quot;)\n        n_18{\&quot;备份文件是否存在?\&quot;}\n        n_19{\&quot;SaveAs方法是否已激活?\&quot;}\n        n_20(\&quot;计算源文件与备份文件MD5\&quot;)\n        n_21{\&quot;MD5是否相同?\&quot;}\n        n_22(\&quot;移除目标文件只读属性\&quot;)\n        n_23(\&quot;使用shutil.copy2复制\&quot;)\n        n_24(\&quot;修改备份文件修改时间\&quot;)\n        n_25(\&quot;使用SaveAs方法备份\n标记SaveAs已激活\&quot;)\n        n_26{\&quot;OpenList是否启用?\&quot;}\n        n_27{\&quot;OpenList是否启用?\&quot;}\n        n_28(\&quot;添加到上传队列\&quot;)\n        n_29(\&quot;检查是否在远端\n不在则添加上传队列\&quot;)\n        n_30(\&quot;跳过备份\&quot;)\n        n_31(\&quot;完成\&quot;)\n    end\n\n    n_15 --&gt; n_16\n    n_16 --&gt; n_17\n    n_17 --&gt; n_18\n    n_18 --&gt;|不存在| n_22\n    n_18 --&gt;|存在| n_19\n    n_19 --&gt;|是| n_30\n    n_19 --&gt;|否| n_20\n    n_20 --&gt; n_21\n    n_21 --&gt;|相同| n_30\n    n_21 --&gt;|不同| n_22\n    n_22 --&gt; n_23\n    n_23 --&gt;|成功| n_24\n    n_23 --&gt;|失败 FileNotFoundError| n_25\n    n_24 --&gt; n_26\n    n_25 --&gt; n_26\n    n_26 --&gt;|是| n_28\n    n_26 --&gt;|否| n_31\n    n_28 --&gt; n_31\n    n_30 --&gt; n_27\n    n_27 --&gt;|是| n_29\n    n_27 --&gt;|否| n_31\n    n_29 --&gt; n_31\n\n    n_10 -.-&gt; n_14\n    n_11 -.-&gt; n_14\n    n_12 -.-&gt; n_14\n\n    subgraph n_32 [OpenList 上传流程]\n        n_33(\&quot;上传线程启动\&quot;)\n        n_34{\&quot;队列是否为空?\&quot;}\n        n_35(\&quot;退出线程\&quot;)\n        n_36(\&quot;取出第一个文件\&quot;)\n        n_37(\&quot;登录OpenList\&quot;)\n        n_38{\&quot;登录成功?\&quot;}\n        n_39(\&quot;禁用上传功能\&quot;)\n        n_40(\&quot;验证目标文件夹\&quot;)\n        n_41{\&quot;文件夹有效?\&quot;}\n        n_42(\&quot;检查远端是否存在同名文件\&quot;)\n        n_43(\&quot;删除远端旧文件\&quot;)\n        n_44(\&quot;上传文件\&quot;)\n        n_45{\&quot;上传成功?\&quot;}\n        n_46(\&quot;添加到远端文件列表缓存\&quot;)\n        n_47(\&quot;放回队列等待重试\&quot;)\n        n_48{\&quot;队列是否还有文件?\&quot;}\n    end\n\n    n_33 --&gt; n_34\n    n_34 --&gt;|是| n_35\n    n_34 --&gt;|否| n_36\n    n_36 --&gt; n_37\n    n_37 --&gt; n_38\n    n_38 --&gt;|否| n_39\n    n_38 --&gt;|是| n_40\n    n_40 --&gt; n_41\n    n_41 --&gt;|否| n_39\n    n_41 --&gt;|是| n_42\n    n_42 --&gt;|存在| n_43\n    n_42 --&gt;|不存在| n_44\n    n_43 --&gt; n_44\n    n_44 --&gt; n_45\n    n_45 --&gt;|是| n_46\n    n_45 --&gt;|否| n_47\n    n_46 --&gt; n_48\n    n_47 --&gt; n_48\n    n_48 --&gt;|有| n_36\n    n_48 --&gt;|没有| n_35\n\n    n_28 -.-&gt; n_32\n    n_29 -.-&gt; n_32&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ztvM1Wgm-mrViN6VH3Ud-1">
